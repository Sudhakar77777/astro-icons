{
  "name": "@arivedha/astro-icons",
  "version": "0.1.1",
  "description": "SVG Web Components for Indian astrology",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./rashi/*": "./src/rashi/*",
    "./rashi/compact/*": "./src/rashi/compact/*"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:demo": "vite build --config vite.config.demo.js",
    "test": "node --test tests/*.test.js"
  },
  "keywords": [
    "astrology",
    "vedic",
    "rashi",
    "zodiac",
    "icons",
    "svg",
    "web-components"
  ],
  "author": "Sudhakar Balakrishnan <sudhakar.ai77777@gmail.com> (https://arivedha.us)",
  "homepage": "https://arivedha.us",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sudhakar77777/astro-icons.git"
  },
  "bugs": {
    "url": "https://github.com/Sudhakar77777/astro-icons/issues"
  },
  "license": "MIT",
  "devDependencies": {
    "vite": "^7.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}